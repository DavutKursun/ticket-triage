# Copy to .env and fill in. Never commit .env. Keys go in this file only — never in a chat.

# LLM engine (zero-shot / few-shot) and silver labelling. Default: Groq free tier.
LLM_PROVIDER=openai_compat        # openai_compat | anthropic
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b

# Optional: Claude (structured outputs via messages.parse). Used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Fine-tuned model (Milestone 3): Hugging Face repo id, downloaded at startup
FT_MODEL_ID=
HF_TOKEN=

# Limits
MAX_TEXT_CHARS=2000
MAX_BATCH=100
MAX_DAILY_USD=1
